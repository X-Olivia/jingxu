---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import FormattedDate from '../components/FormattedDate.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post }
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, seoTitle, description, pubDate, updatedDate, tags, coverImage } = post.data;
const base = import.meta.env.BASE_URL;
const tableOfContents = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<BaseLayout title={seoTitle || title} description={description} image={coverImage}>
	<div class='container lg:grid lg:grid-cols-[minmax(0,1fr)_250px] lg:gap-12'>
		<main class='min-w-0 overflow-hidden'>
			<article>
				<header class='mb-8'>
					<h1 class='text-balance text-4xl font-black leading-tight tracking-tight sm:text-5xl'>{title}</h1>
					<div class='mt-5 flex flex-col gap-3 border-b border-zinc-200 pb-5 text-sm text-zinc-500 dark:border-zinc-700 dark:text-zinc-400 sm:flex-row sm:items-center sm:justify-between'>
						<ul class='flex flex-wrap gap-2' aria-label='Post tags'>
							{tags.map((tag) => (
								<li>
									<a
										class='rounded-full border border-zinc-300 px-2.5 py-1 no-underline transition hover:border-zinc-700 dark:border-zinc-700 dark:hover:border-zinc-300'
										href={`${base}tags/${encodeURIComponent(tag.toLowerCase())}/`}
									>
										{tag}
									</a>
								</li>
							))}
						</ul>
						<p class='shrink-0'>
							{updatedDate ? (
								<>Updated <strong class='font-semibold text-zinc-700 dark:text-zinc-200'><FormattedDate date={updatedDate} /></strong></>
							) : (
								<>Published <strong class='font-semibold text-zinc-700 dark:text-zinc-200'><FormattedDate date={pubDate} /></strong></>
							)}
						</p>
					</div>
				</header>

				{coverImage && (
					<img
						src={coverImage}
						alt=''
						class='mb-8 aspect-[16/9] w-full rounded-3xl object-cover'
						loading='eager'
					/>
				)}

				<Prose>
					<Content />
				</Prose>
			</article>
		</main>

		{tableOfContents.length > 0 && (
			<aside class='hidden lg:block'>
				<nav class='sticky top-24 border-l border-zinc-200 pl-5 dark:border-zinc-700' aria-label='Table of contents'>
					<p class='mb-3 text-xs font-bold uppercase tracking-[0.16em] text-zinc-500'>On this page</p>
					<ul class='space-y-2 text-sm text-zinc-600 dark:text-zinc-300'>
						{tableOfContents.map((heading) => (
							<li class:list={{ 'pl-3': heading.depth === 3 }}>
								<a class='transition hover:text-cyan-700 dark:hover:text-cyan-300' href={`#${heading.slug}`}>
									{heading.text}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</aside>
		)}
	</div>
</BaseLayout>
