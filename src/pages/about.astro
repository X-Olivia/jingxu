---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Head from '@src/assets/img/head.jpg';
import PersonalBio from '../components/PersonalBio.astro';
---

<BaseLayout title='About Me' description='About Jing.'>
	<div class='container flex min-h-[calc(100dvh-14rem)] items-center'>
		<main class='prose w-full text-lg dark:prose-invert'>
			<article>
				<div class='w-full md:flex md:items-center gap-12'>
					<div class='text-pretty leading-9 flex-1'>
						<h1 class='text-4xl font-bold mb-4'>Hi There 👋,   Jing Here!</h1>
						<PersonalBio />
					</div>
					<Image
						src={Head}
						alt='Jing'
						width='260'
						class='h-[260px] w-[260px] object-cover rounded-3xl mx-4 md:mx-0'
					/>
				</div>
			</article>
		</main>
	</div>
</BaseLayout>
