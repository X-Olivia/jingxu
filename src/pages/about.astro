---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Head from '@src/assets/img/head.jpg';
import PersonalBio from '../components/PersonalBio.astro';
---

<BaseLayout title='About Me' description='About Jing.'>
	<div class='container flex min-h-0 items-start md:min-h-[calc(100dvh-14rem)] md:items-center'>
		<main class='prose w-full min-w-0 text-lg prose-img:mx-auto dark:prose-invert'>
			<article>
				<div class='flex w-full min-w-0 flex-col items-center gap-8 md:flex-row md:items-center md:gap-12'>
					<div class='min-w-0 flex-1 text-pretty leading-8 md:leading-9'>
						<h1 class='mb-4 text-balance text-3xl font-bold sm:text-4xl'>Hi There 👋, Jing Here!</h1>
						<PersonalBio />
					</div>
					<Image
						src={Head}
						alt='Jing'
						width='260'
						class='mx-auto block aspect-square h-auto w-full max-w-[220px] rounded-3xl object-cover sm:max-w-[260px] md:mx-0'
					/>
				</div>
			</article>
		</main>
	</div>
</BaseLayout>
