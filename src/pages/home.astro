---
import { getCollection, type CollectionEntry } from 'astro:content';
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Head from '@src/assets/img/head.jpg';
import { projects } from '../data/projects';
import ProjectList from '../components/ProjectList.astro';
import PersonalBio from '../components/PersonalBio.astro';
import PostItem from '../components/PostItem.astro';

const top6Projects = projects.slice(0, 6);
const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={SITE_TITLE + ' - ' + SITE_TAGLINE} description={SITE_DESCRIPTION}>
	<div class='container'>
		<div class='mb-10 flex w-full min-w-0 flex-col items-center gap-8 md:flex-row md:items-center md:gap-12'>
			<div class='min-w-0 flex-1 text-pretty leading-8 md:leading-9'>
				<h1 class='mb-4 text-balance text-3xl font-bold sm:text-4xl'>Hi There 👋, Jing Here!</h1>
				<PersonalBio />
			</div>
			<Image
				src={Head}
				alt='Jing'
				width='260'
				loading='eager'
				class='mx-auto block aspect-square h-auto w-full max-w-[220px] rounded-3xl object-cover sm:max-w-[260px] md:mx-0'
			/>
		</div>
		<main>
			<div class='mt-6 mb-12'>
				<div class='mb-1 flex items-baseline justify-between gap-3 border-b dark:border-b-zinc-700'>
					<h2 class='mb-3 text-lg font-bold'>Recent Posts</h2>
					<a href={`${base}posts/`} class='inline-block shrink-0 py-2 underline dark:prose-invert'>All posts &raquo;</a>
				</div>
				{recentPosts.length > 0 ? (
					recentPosts.map((post) => <PostItem post={post} />)
				) : (
					<p class='py-6 text-zinc-500 dark:text-zinc-400'>No posts yet.</p>
				)}
			</div>
			<div>
				<div class='mb-1 flex items-baseline justify-between gap-3'>
					<h2 class='mb-3 text-lg font-bold'>My Projects</h2>
					<a href={`${base}projects/`} class='inline-block shrink-0 py-2 underline dark:prose-invert'>All projects &raquo;</a>
				</div>
				<ProjectList projects={top6Projects} limit={6} />
			</div>
		</main>
	</div>
</BaseLayout>
