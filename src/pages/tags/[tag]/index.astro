---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostsByYear from '../../../components/PostsByYear.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	const tags = [...new Set(posts.flatMap(({ data }) => data.tags))];

	return tags.map((tag) => ({
		params: { tag: tag.toLowerCase() },
		props: {
			tag,
			posts: posts.filter(({ data }) => data.tags.includes(tag))
		}
	}));
}

interface Props {
	tag: string;
	posts: CollectionEntry<'blog'>[];
}

const { tag, posts } = Astro.props;
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`Posts tagged ${tag}`} description={`Posts tagged ${tag}.`}>
	<div class='container'>
		<header class='mb-10'>
			<p class='mb-2 text-sm text-zinc-500 dark:text-zinc-400'>Tag</p>
			<h1 class='text-3xl font-bold'>{tag}</h1>
		</header>
		<PostsByYear posts={sortedPosts} />
	</div>
</BaseLayout>
