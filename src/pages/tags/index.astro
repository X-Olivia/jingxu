---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const posts = await getCollection('blog', ({ data }) => !data.draft);
const tags = [...new Set(posts.flatMap(({ data }) => data.tags))].sort((a, b) => a.localeCompare(b));
---

<BaseLayout title='All Tags' description='Post tags by Jing.'>
	<div class='container'>
		<div class='mb-10'>
			<h1 class='text-3xl font-bold mb-2'>All Tags</h1>
		</div>
		<ul class='flex flex-wrap gap-3 border-t border-zinc-200 pt-8 dark:border-zinc-700'>
			{tags.map((tag) => (
				<li>
					<a
						href={`${base}tags/${encodeURIComponent(tag.toLowerCase())}/`}
						class='inline-flex rounded-full border border-zinc-300 px-4 py-2 text-sm font-semibold transition hover:-translate-y-0.5 hover:border-cyan-500 dark:border-zinc-700'
					>
						{tag}
					</a>
				</li>
			))}
		</ul>
	</div>
</BaseLayout>
