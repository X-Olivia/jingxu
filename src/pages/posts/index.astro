---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostsByYear from '../../components/PostsByYear.astro';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
		b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title='All posts' description='Posts by Jing.'>
	<div class='container'>
		<div class='mb-10'>
			<h1 class='text-3xl font-bold mb-2'>All posts</h1>
			<a
				href={`${base}admin/`}
				class='text-sm text-zinc-500 underline decoration-zinc-300 underline-offset-4 transition hover:text-zinc-950 hover:decoration-cyan-500 dark:text-zinc-400 dark:hover:text-white'
			>
				create a new post
			</a>
		</div>
		<PostsByYear posts={posts} />
	</div>
</BaseLayout>
