---
const title = 'Mind at Peace';
const base = import.meta.env.BASE_URL;
const homeHref = `${base}home/`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content="Drag the dot to turn a tangled line into a calm one." />
		<title>{title}</title>
		<style>
			:root {
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				color: #11110f;
				background: #fff;
				font-synthesis: none;
			}

			* {
				box-sizing: border-box;
			}

			html,
			body {
				width: 100%;
				min-width: 320px;
				height: 100%;
				margin: 0;
				overflow: hidden;
			}

			body {
				background-color: #fff;
				background-image: radial-gradient(circle at 50% -20%, rgb(6 182 212 / 0.08), transparent 32rem);
			}

			main {
				display: grid;
				width: 100%;
				height: 100dvh;
				grid-template-rows: auto minmax(0, 1fr);
				padding: max(1.15rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-right)) max(1.15rem, env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left));
			}

			@media (min-width: 768px) {
				main {
					padding: clamp(1.5rem, 4vw, 3.5rem);
				}
			}

			header {
				position: relative;
				z-index: 2;
				text-align: center;
			}

			.eyebrow {
				margin: 0.55rem 0 0;
				color: #77746c;
				font-family: ui-serif, "Songti SC", "STSong", serif;
				font-size: clamp(0.85rem, 1.8vw, 1rem);
				font-weight: 400;
				letter-spacing: 0.14em;
			}

			h1 {
				margin: 0;
				font-size: clamp(1.55rem, 3vw, 2.45rem);
				letter-spacing: -0.045em;
			}

			.instruction {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.45rem;
				margin: 0.7rem 0 0;
				color: #77746c;
				font-size: clamp(0.95rem, 2vw, 1.1rem);
			}

			.arrow {
				display: inline-block;
				animation: nudge 1.4s ease-in-out infinite;
			}

			.stage {
				position: relative;
				width: 100%;
				min-height: 0;
			}

			canvas {
				display: block;
				width: 100%;
				height: 100%;
				touch-action: none;
				cursor: grab;
			}

			canvas.is-dragging {
				cursor: grabbing;
			}

			.progress {
				position: absolute;
				right: 0;
				bottom: 1rem;
				left: 0;
				margin: auto;
				color: #858179;
				font-variant-numeric: tabular-nums;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-align: center;
				text-transform: uppercase;
				pointer-events: none;
			}

			.start-link {
				position: absolute;
				z-index: 2;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				padding: 0.35rem 0.15rem;
				color: inherit;
				font-size: clamp(0.72rem, 1.5vw, 0.82rem);
				font-weight: 700;
				letter-spacing: 0.02em;
				text-decoration: none;
				white-space: nowrap;
				cursor: pointer;
				opacity: 0;
				transform: translateY(-0.2rem);
				pointer-events: none;
				transition: opacity 300ms ease, transform 300ms ease;
			}

			.start-link::after {
				content: "↗";
				font-size: 0.9em;
			}

			.start-link:hover {
				text-decoration: underline;
				text-underline-offset: 0.25rem;
			}

			.start-link.is-visible {
				opacity: 1;
				transform: translateY(0);
				pointer-events: auto;
			}

			@keyframes nudge {
				50% {
					transform: translateX(0.3rem);
				}
			}

			@media (max-height: 600px) {
				main {
					padding-block: 1rem;
				}

				.eyebrow {
					display: none;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.arrow {
					animation: none;
				}

				.start-link {
					transition: none;
				}
			}

			:global(html.dark) {
				color: #f4f4f5;
				background: #18181b;
			}

			:global(html.dark) body {
				background-color: #18181b;
			}
		</style>
		<script is:inline>
			(() => {
				const storedTheme = localStorage.getItem('theme');
				const dark = storedTheme ? storedTheme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.classList.toggle('dark', dark);
			})();
		</script>
	</head>
	<body>
		<main>
			<header>
				<h1>Before Enter</h1>
				<p class="eyebrow" lang="zh-CN">即展眉头，灵台清幽</p>
				<p class="instruction">Drag the dot <span class="arrow" aria-hidden="true">→</span></p>
			</header>

			<section class="stage">
				<canvas
					id="untangle"
					role="slider"
					aria-label="Untangle the line"
					aria-valuemin="0"
					aria-valuemax="100"
					aria-valuenow="0"
					tabindex="0"
				></canvas>
				<div class="progress" aria-hidden="true"><span>0</span>% calm</div>
				<a class="start-link" id="start" href={homeHref}>Click to start</a>
			</section>
		</main>

		<script>
			const canvas = document.querySelector<HTMLCanvasElement>('#untangle');
			const stage = document.querySelector<HTMLElement>('.stage');
			const progressText = document.querySelector<HTMLElement>('.progress span');
			const startLink = document.querySelector<HTMLAnchorElement>('#start');

			if (!canvas || !stage || !progressText || !startLink) {
				throw new Error('Untangle canvas could not be initialized.');
			}

			const context = canvas.getContext('2d');
			if (!context) {
				throw new Error('Canvas 2D is not supported.');
			}

			const pointCount = 150;
			let width = 0;
			let height = 0;
			let targetProgress = 0;
			let displayedProgress = 0;
			let dragging = false;
			let completed = false;

			const clamp = (value: number, min = 0, max = 1) => Math.min(max, Math.max(min, value));
			const smoothstep = (edge0: number, edge1: number, value: number) => {
				const x = clamp((value - edge0) / (edge1 - edge0));
				return x * x * (3 - 2 * x);
			};

			const geometry = () => {
				const horizontalPadding = Math.min(Math.max(width * 0.1, 22), 72);
				const usableWidth = Math.max(width - horizontalPadding * 2, 1);
				return {
					left: (width - usableWidth) / 2,
					right: (width + usableWidth) / 2,
					usableWidth,
					baseline: height * 0.5,
				};
			};

			const messyPoint = (t: number) => {
				const { left, usableWidth, baseline } = geometry();
				const horizontalChaos =
					Math.sin(t * Math.PI * 9.5 + 0.35) * 0.076 +
					Math.sin(t * Math.PI * 23 - 0.8) * 0.025;
				const verticalChaos =
					Math.sin(t * Math.PI * 7.2 - 0.7) * 0.23 +
					Math.sin(t * Math.PI * 17.4 + 1.1) * 0.105 +
					Math.sin(t * Math.PI * 31) * 0.025;
				const edgeTaper = Math.sin(Math.PI * clamp(t)) ** 0.34;

				return {
					x: left + usableWidth * clamp(t + horizontalChaos * edgeTaper, -0.02, 1.02),
					y: baseline + height * verticalChaos * edgeTaper,
				};
			};

			const resolvedPoint = (t: number, progress: number) => {
				const { left, usableWidth, baseline } = geometry();
				const messy = messyPoint(t);
				const straight = { x: left + usableWidth * t, y: baseline };
				const front = smoothstep(t - 0.11, t + 0.045, progress);
				const settle = smoothstep(0.9, 1, progress);
				const amount = Math.max(front, settle);

				return {
					x: messy.x + (straight.x - messy.x) * amount,
					y: messy.y + (straight.y - messy.y) * amount,
				};
			};

			const drawSmoothPath = (points: Array<{ x: number; y: number }>) => {
				context.beginPath();
				context.moveTo(points[0].x, points[0].y);

				for (let index = 1; index < points.length - 1; index += 1) {
					const current = points[index];
					const next = points[index + 1];
					context.quadraticCurveTo(
						current.x,
						current.y,
						(current.x + next.x) / 2,
						(current.y + next.y) / 2,
					);
				}

				const last = points.at(-1);
				if (last) context.lineTo(last.x, last.y);
				context.stroke();
			};

			const render = () => {
				displayedProgress += (targetProgress - displayedProgress) * (dragging ? 0.22 : 0.085);
				if (Math.abs(targetProgress - displayedProgress) < 0.0002) {
					displayedProgress = targetProgress;
				}

				context.clearRect(0, 0, width, height);
				context.lineWidth = Math.max(3, Math.min(5, width / 260));
				context.lineCap = 'round';
				context.lineJoin = 'round';
				context.strokeStyle = document.documentElement.classList.contains('dark') ? '#f4f4f5' : '#11110f';

				const points = Array.from({ length: pointCount }, (_, index) =>
					resolvedPoint(index / (pointCount - 1), displayedProgress),
				);
				drawSmoothPath(points);

				const { left, usableWidth, baseline } = geometry();
				const knobX = left + usableWidth * displayedProgress;
				const knobRadius = Math.max(13, Math.min(20, width / 58));
				context.beginPath();
				context.arc(knobX, baseline, knobRadius, 0, Math.PI * 2);
				context.fillStyle = document.documentElement.classList.contains('dark') ? '#f4f4f5' : '#11110f';
				context.fill();

				const linkWidth = startLink.offsetWidth || 110;
				const linkLeft = Math.min(knobX + knobRadius * 0.65, Math.max(8, width - linkWidth - 8));
				const linkTop = Math.min(baseline + knobRadius * 0.7, height - 36);
				startLink.style.left = `${linkLeft}px`;
				startLink.style.top = `${linkTop}px`;

				const percent = Math.round(displayedProgress * 100);
				progressText.textContent = String(percent);
				canvas.setAttribute('aria-valuenow', String(percent));

				if (!completed && displayedProgress > 0.992) {
					completed = true;
					startLink.classList.add('is-visible');
				}

				requestAnimationFrame(render);
			};

			const resize = () => {
				const rect = stage.getBoundingClientRect();
				const ratio = Math.min(window.devicePixelRatio || 1, 2);
				width = Math.max(1, rect.width);
				height = Math.max(1, rect.height);
				canvas.width = Math.round(width * ratio);
				canvas.height = Math.round(height * ratio);
				canvas.style.width = `${width}px`;
				canvas.style.height = `${height}px`;
				context.setTransform(ratio, 0, 0, ratio, 0, 0);
			};

			const setProgressFromPointer = (event: PointerEvent) => {
				const rect = canvas.getBoundingClientRect();
				const { left, usableWidth } = geometry();
				targetProgress = clamp((event.clientX - rect.left - left) / usableWidth);
			};

			canvas.addEventListener('pointerdown', (event) => {
				const rect = canvas.getBoundingClientRect();
				const { left, usableWidth, baseline } = geometry();
				const knobX = left + usableWidth * displayedProgress;
				const distance = Math.hypot(event.clientX - rect.left - knobX, event.clientY - rect.top - baseline);

				if (distance > 48) return;
				dragging = true;
				canvas.classList.add('is-dragging');
				canvas.setPointerCapture(event.pointerId);
				setProgressFromPointer(event);
			});

			canvas.addEventListener('pointermove', (event) => {
				if (dragging) setProgressFromPointer(event);
			});

			const stopDragging = (event: PointerEvent) => {
				if (!dragging) return;
				dragging = false;
				canvas.classList.remove('is-dragging');
				if (canvas.hasPointerCapture(event.pointerId)) canvas.releasePointerCapture(event.pointerId);
				if (targetProgress > 0.88) targetProgress = 1;
			};

			canvas.addEventListener('pointerup', stopDragging);
			canvas.addEventListener('pointercancel', stopDragging);

			canvas.addEventListener('keydown', (event) => {
				if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
				event.preventDefault();
				if (event.key === 'Home') targetProgress = 0;
				if (event.key === 'End') targetProgress = 1;
				if (event.key === 'ArrowLeft') targetProgress = clamp(targetProgress - 0.05);
				if (event.key === 'ArrowRight') targetProgress = clamp(targetProgress + 0.05);
			});

			new ResizeObserver(resize).observe(stage);
			resize();
			requestAnimationFrame(render);
		</script>
	</body>
</html>
